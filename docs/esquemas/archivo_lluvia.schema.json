{
  "$defs": {
    "CeldaArchivada": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Nodo de 0.25° pedido, 'lat,lon' con dos decimales.",
          "type": "string"
        },
        "latitud": {
          "description": "Celda que devolvió el sistema.",
          "maximum": 90,
          "minimum": -90,
          "type": "number"
        },
        "longitud": {
          "maximum": 180,
          "minimum": -180,
          "type": "number"
        },
        "altitud_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "dias": {
          "items": {
            "$ref": "#/$defs/DiaArchivado"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "id",
        "latitud",
        "longitud",
        "altitud_m",
        "dias"
      ],
      "title": "CeldaArchivada",
      "type": "object"
    },
    "CeldaModelo": {
      "additionalProperties": false,
      "description": "Celda de 0.25° que Open-Meteo usó para el distrito (la del sistema ECMWF ancla).",
      "properties": {
        "latitud": {
          "maximum": 90,
          "minimum": -90,
          "type": "number"
        },
        "longitud": {
          "maximum": 180,
          "minimum": -180,
          "type": "number"
        },
        "altitud_m": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Altitud media de la celda en el modelo."
        }
      },
      "required": [
        "latitud",
        "longitud",
        "altitud_m"
      ],
      "title": "CeldaModelo",
      "type": "object"
    },
    "CorridaUsada": {
      "additionalProperties": false,
      "properties": {
        "sistema": {
          "enum": [
            "ecmwf_ifs",
            "ecmwf_aifs",
            "ncep_gefs"
          ],
          "type": "string"
        },
        "modelo": {
          "description": "Identificador del modelo en Open-Meteo.",
          "type": "string"
        },
        "inicializacion": {
          "format": "date-time",
          "type": "string"
        },
        "miembros": {
          "minimum": 1,
          "type": "integer"
        },
        "peso": {
          "description": "Peso renormalizado entre las corridas usadas.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "type": "number"
        }
      },
      "required": [
        "sistema",
        "modelo",
        "inicializacion",
        "miembros",
        "peso"
      ],
      "title": "CorridaUsada",
      "type": "object"
    },
    "CriteriosNiveles": {
      "additionalProperties": false,
      "description": "Porcentajes mínimos (comparados con ``>=``) que activan cada nivel; gana el más alto.",
      "properties": {
        "amarillo_t1": {
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        },
        "naranja_t2": {
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        },
        "naranja_t3": {
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        },
        "rojo_t3": {
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        },
        "rojo_t2": {
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "amarillo_t1",
        "naranja_t2",
        "naranja_t3",
        "rojo_t3",
        "rojo_t2"
      ],
      "title": "CriteriosNiveles",
      "type": "object"
    },
    "DiaArchivado": {
      "additionalProperties": false,
      "description": "Un día de 12 a 12 UTC de una celda en un sistema.",
      "properties": {
        "inicio": {
          "format": "date-time",
          "type": "string"
        },
        "validos": {
          "description": "Miembros con dato ese día.",
          "minimum": 0,
          "type": "integer"
        },
        "alcanzan": {
          "description": "Miembros válidos con lluvia ≥ cada umbral de ``umbrales_conteo_mm``.",
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "lluvia_mm": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "Lluvia por miembro (0 = control); None en sistemas no descargados ahora."
        }
      },
      "required": [
        "inicio",
        "validos",
        "alcanzan",
        "lluvia_mm"
      ],
      "title": "DiaArchivado",
      "type": "object"
    },
    "DiaDistritoLluvia": {
      "additionalProperties": false,
      "properties": {
        "nivel": {
          "anyOf": [
            {
              "enum": [
                1,
                2,
                3,
                4
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "None: ningún sistema ECMWF tuvo dato."
        },
        "probabilidades": {
          "anyOf": [
            {
              "items": {
                "maximum": 100,
                "minimum": 0,
                "type": "integer"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "P(≥T1), P(≥T2) y P(≥T3) de la zona del distrito, en %."
        }
      },
      "required": [
        "nivel",
        "probabilidades"
      ],
      "title": "DiaDistritoLluvia",
      "type": "object"
    },
    "DiaPronostico": {
      "additionalProperties": false,
      "description": "Día pluviométrico: de las 7 a. m. a las 7 a. m. del día siguiente en Perú.",
      "properties": {
        "inicio": {
          "format": "date-time",
          "type": "string"
        },
        "fin": {
          "format": "date-time",
          "type": "string"
        },
        "sistemas": {
          "description": "Sistemas con dato ese día.",
          "items": {
            "enum": [
              "ecmwf_ifs",
              "ecmwf_aifs",
              "ncep_gefs"
            ],
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "inicio",
        "fin",
        "sistemas"
      ],
      "title": "DiaPronostico",
      "type": "object"
    },
    "DistritoLluvia": {
      "additionalProperties": false,
      "properties": {
        "ubigeo": {
          "pattern": "^\\d{6}$",
          "type": "string"
        },
        "zona": {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ],
          "type": "string"
        },
        "celda": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Índice en ``celdas``; None si no hubo dato."
        },
        "mal_representado": {
          "description": "La celda es mar o su altitud difiere demasiado de la capital.",
          "type": "boolean"
        },
        "dias": {
          "items": {
            "$ref": "#/$defs/DiaDistritoLluvia"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "tendencia": {
          "anyOf": [
            {
              "enum": [
                1,
                2,
                3
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ubigeo",
        "zona",
        "celda",
        "mal_representado",
        "dias",
        "tendencia"
      ],
      "title": "DistritoLluvia",
      "type": "object"
    },
    "LluviaDistritos": {
      "additionalProperties": false,
      "description": "Semáforo de lluvia por distrito, sin verificar todavía.",
      "properties": {
        "version_esquema": {
          "const": 1,
          "default": 1,
          "type": "integer"
        },
        "generado_en": {
          "format": "date-time",
          "type": "string"
        },
        "verificacion": {
          "const": "sin_verificar",
          "type": "string"
        },
        "metodo": {
          "$ref": "#/$defs/MetodoLluvia"
        },
        "corridas": {
          "items": {
            "$ref": "#/$defs/CorridaUsada"
          },
          "minItems": 1,
          "type": "array"
        },
        "dias": {
          "items": {
            "$ref": "#/$defs/DiaPronostico"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "tendencia": {
          "$ref": "#/$defs/PeriodoTendencia"
        },
        "celdas": {
          "items": {
            "$ref": "#/$defs/CeldaModelo"
          },
          "type": "array"
        },
        "distritos": {
          "items": {
            "$ref": "#/$defs/DistritoLluvia"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "version_esquema",
        "generado_en",
        "verificacion",
        "metodo",
        "corridas",
        "dias",
        "tendencia",
        "celdas",
        "distritos"
      ],
      "title": "LluviaDistritos",
      "type": "object"
    },
    "MetodoLluvia": {
      "additionalProperties": false,
      "description": "Criterios con que se calculó el producto, para que viajen con los datos.",
      "properties": {
        "modelo": {
          "const": "m1-v1",
          "type": "string"
        },
        "pesos": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Pesos nominales de la mezcla.",
          "propertyNames": {
            "enum": [
              "ecmwf_ifs",
              "ecmwf_aifs",
              "ncep_gefs"
            ]
          },
          "type": "object"
        },
        "umbrales_mm": {
          "additionalProperties": {
            "$ref": "#/$defs/UmbralesZona"
          },
          "description": "Lluvia diaria de 12 a 12 UTC; provisionales hasta contrastarlos.",
          "propertyNames": {
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "type": "object"
        },
        "niveles": {
          "$ref": "#/$defs/CriteriosNiveles"
        },
        "tope_tendencia": {
          "enum": [
            1,
            2,
            3,
            4
          ],
          "type": "integer"
        },
        "desfase_maximo_h": {
          "description": "Distancia máxima entre la corrida de un sistema y la ECMWF más reciente.",
          "minimum": 0,
          "type": "integer"
        },
        "altitud_sierra_m": {
          "type": "integer"
        },
        "diferencia_altitud_costa_m": {
          "description": "Capital por debajo de altitud_sierra_m: diferencia máxima con la celda.",
          "type": "integer"
        },
        "diferencia_altitud_sierra_m": {
          "description": "Capital a altitud_sierra_m o más: diferencia máxima con la celda.",
          "type": "integer"
        }
      },
      "required": [
        "modelo",
        "pesos",
        "umbrales_mm",
        "niveles",
        "tope_tendencia",
        "desfase_maximo_h",
        "altitud_sierra_m",
        "diferencia_altitud_costa_m",
        "diferencia_altitud_sierra_m"
      ],
      "title": "MetodoLluvia",
      "type": "object"
    },
    "PeriodoTendencia": {
      "additionalProperties": false,
      "description": "Días 4 a 7: un único nivel, el más alto, con tope y confianza baja.",
      "properties": {
        "inicio": {
          "format": "date-time",
          "type": "string"
        },
        "fin": {
          "format": "date-time",
          "type": "string"
        },
        "confianza": {
          "const": "baja",
          "type": "string"
        }
      },
      "required": [
        "inicio",
        "fin",
        "confianza"
      ],
      "title": "PeriodoTendencia",
      "type": "object"
    },
    "SistemaArchivado": {
      "additionalProperties": false,
      "properties": {
        "sistema": {
          "enum": [
            "ecmwf_ifs",
            "ecmwf_aifs",
            "ncep_gefs"
          ],
          "type": "string"
        },
        "modelo": {
          "type": "string"
        },
        "miembros": {
          "minimum": 1,
          "type": "integer"
        },
        "inicializacion": {
          "format": "date-time",
          "type": "string"
        },
        "primer_dia": {
          "format": "date-time",
          "type": "string"
        },
        "obtenido_en": {
          "format": "date-time",
          "type": "string"
        },
        "celdas": {
          "items": {
            "$ref": "#/$defs/CeldaArchivada"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "sistema",
        "modelo",
        "miembros",
        "inicializacion",
        "primer_dia",
        "obtenido_en",
        "celdas"
      ],
      "title": "SistemaArchivado",
      "type": "object"
    },
    "UmbralesZona": {
      "additionalProperties": false,
      "properties": {
        "t1_mm": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "t2_mm": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "t3_mm": {
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "t1_mm",
        "t2_mm",
        "t3_mm"
      ],
      "title": "UmbralesZona",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Un archivo por ejecución que descargó al menos un sistema (``.json.gz``).",
  "properties": {
    "formato": {
      "const": "radar-nino-norte/archivo-lluvia",
      "type": "string"
    },
    "version_formato": {
      "const": 1,
      "type": "integer"
    },
    "generado_en": {
      "format": "date-time",
      "type": "string"
    },
    "version_pipeline": {
      "type": "string"
    },
    "commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Commit del código que lo generó, si se conoce."
    },
    "hora_corte_utc": {
      "const": 12,
      "type": "integer"
    },
    "umbrales_conteo_mm": {
      "items": {
        "type": "number"
      },
      "minItems": 1,
      "type": "array"
    },
    "descargados": {
      "description": "Sistemas descargados en esta ejecución: solo ellos traen lluvia_mm.",
      "items": {
        "enum": [
          "ecmwf_ifs",
          "ecmwf_aifs",
          "ncep_gefs"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "sistemas": {
      "description": "Último dato de cada sistema conocido en ese momento.",
      "items": {
        "$ref": "#/$defs/SistemaArchivado"
      },
      "type": "array"
    },
    "pronostico": {
      "anyOf": [
        {
          "$ref": "#/$defs/LluviaDistritos"
        },
        {
          "type": "null"
        }
      ],
      "description": "Producto emitido en esta ejecución; None si no se emitió."
    }
  },
  "required": [
    "formato",
    "version_formato",
    "generado_en",
    "version_pipeline",
    "commit",
    "hora_corte_utc",
    "umbrales_conteo_mm",
    "descargados",
    "sistemas",
    "pronostico"
  ],
  "title": "ArchivoLluvia",
  "type": "object"
}
